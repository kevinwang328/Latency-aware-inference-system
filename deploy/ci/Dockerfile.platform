FROM python:3.12-slim
ARG REVISION
LABEL org.opencontainers.image.revision=$REVISION
WORKDIR /app
COPY requirements-production.txt .ci-constraints.txt ./
RUN pip install --no-cache-dir -c .ci-constraints.txt -r requirements-production.txt
COPY system ./system
CMD ["uvicorn", "system.api_server:app", "--host", "0.0.0.0", "--port", "8000"]
