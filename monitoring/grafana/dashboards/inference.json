{
  "uid": "inference-overview",
  "title": "Inference Service Overview",
  "description": "Local inference service metrics collected by Prometheus every 15 seconds.",
  "schemaVersion": 41,
  "version": 3,
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": [
    "inference",
    "infra"
  ],
  "panels": [
    {
      "id": 1,
      "title": "请求速率 / Requests per second",
      "description": "每秒进入 POST /predict 的请求数，含失败请求；不是成功吞吐量。",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(predict_requests_total{job=\"inference-api\"}[$__rate_interval]))",
          "legendFormat": "请求速率",
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum(rate(predict_responses_total{job=\"inference-api\",status_code=\"200\"}[$__rate_interval]))",
          "legendFormat": "成功请求速率 (200)",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 2,
      "title": "拒绝率与错误率 / Response ratios",
      "description": "按已结束请求计算：503 为服务不可用，当前包括过载拒绝；500 为内部错误；504 为超时；422 为参数错误。没有请求时不显示比例。",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum by (status_code) (rate(predict_responses_total{job=\"inference-api\",status_code=~\"422|500|503|504\"}[$__rate_interval])) / scalar(sum(rate(predict_responses_total{job=\"inference-api\"}[$__rate_interval])))) and on() (sum(rate(predict_responses_total{job=\"inference-api\"}[$__rate_interval])) > 0)",
          "legendFormat": "HTTP {{status_code}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "spanNulls": false
          },
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 3,
      "title": "成功请求 P95 / Successful request latency",
      "description": "仅统计 HTTP 200 的 API 内部处理耗时；直方图估算，不含客户端网络耗时。无成功请求时没有 P95。",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(predict_duration_seconds_bucket{job=\"inference-api\",status_code=\"200\"}[$__rate_interval])))",
          "legendFormat": "P95 延迟",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 4,
      "title": "累计请求 / Since API startup",
      "description": "当前 API 进程累计请求数，API 重启后清零；Prometheus 仍保存历史采样。",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(predict_requests_total{job=\"inference-api\"})",
          "legendFormat": "累计请求",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    }
  ]
}
