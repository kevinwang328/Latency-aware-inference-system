{
  "uid": "inference-overview",
  "title": "Inference Service Overview",
  "description": "Local inference service metrics collected by Prometheus every 15 seconds.",
  "schemaVersion": 41,
  "version": 5,
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": [
    "inference",
    "infra"
  ],
  "panels": [
    {
      "id": 1,
      "title": "请求速率 / Requests per second",
      "description": "每秒进入 POST /predict 的请求数，含失败请求；不是成功吞吐量。",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(predict_requests_total{job=\"inference-api\"}[$__rate_interval]))",
          "legendFormat": "请求速率",
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum(rate(predict_responses_total{job=\"inference-api\",status_code=\"200\"}[$__rate_interval]))",
          "legendFormat": "成功请求速率 (200)",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 2,
      "title": "拒绝率与错误率 / Response ratios",
      "description": "按已结束请求计算：503 为服务不可用，当前包括过载拒绝；500 为内部错误；504 为超时；422 为参数错误。没有请求时不显示比例。",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum by (status_code) (rate(predict_responses_total{job=\"inference-api\",status_code=~\"422|500|503|504\"}[$__rate_interval])) / scalar(sum(rate(predict_responses_total{job=\"inference-api\"}[$__rate_interval])))) and on() (sum(rate(predict_responses_total{job=\"inference-api\"}[$__rate_interval])) > 0)",
          "legendFormat": "HTTP {{status_code}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "spanNulls": false
          },
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 3,
      "title": "成功请求 P95 / Successful request latency",
      "description": "仅统计 HTTP 200 的 API 内部处理耗时；直方图估算，不含客户端网络耗时。无成功请求时没有 P95。",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(predict_duration_seconds_bucket{job=\"inference-api\",status_code=\"200\"}[$__rate_interval])))",
          "legendFormat": "P95 延迟",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 4,
      "title": "累计请求 / Since API startup",
      "description": "当前 API 进程累计请求数，API 重启后清零；Prometheus 仍保存历史采样。",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(predict_requests_total{job=\"inference-api\"})",
          "legendFormat": "累计请求",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 5,
      "title": "重试速率 / Retry activity",
      "description": "已被其他 worker 接受的重试与成功完成的重试，每秒事件数。提交与完成发生在不同时间，不表示同一批任务的成功率。",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(inference_retry_submissions_total{job=\"inference-api\"}[$__rate_interval]))",
          "legendFormat": "提交 / Accepted",
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum(rate(inference_retry_completions_total{job=\"inference-api\"}[$__rate_interval]))",
          "legendFormat": "完成 / Completed",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 6,
      "title": "重试提交 / Accepted retries",
      "type": "stat",
      "description": "所选时间范围内的事件增量，使用 Prometheus increase 估算并处理计数器重置。采样外推可能产生小数；缺少样本时显示无数据。",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(inference_retry_submissions_total{job=\"inference-api\"}[$__range]))",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 7,
      "title": "重试完成 / Completed retries",
      "type": "stat",
      "description": "所选时间范围内的事件增量，使用 Prometheus increase 估算并处理计数器重置。采样外推可能产生小数；缺少样本时显示无数据。",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(inference_retry_completions_total{job=\"inference-api\"}[$__range]))",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 8,
      "title": "已发现 worker / Registered workers",
      "description": "API 当前发现的 ZooKeeper worker 数量；不表示 worker 健康或空闲。",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(inference_registered_workers{job=\"inference-api\"})",
          "legendFormat": "已发现 / Registered",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "spanNulls": false
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 9,
      "title": "API 队列深度 / API queue depth",
      "description": "等待 scheduler 取走的公共队列任务数，不含 scheduler 缓存、worker 私有队列或正在执行的任务。15 秒采样可能遗漏短暂峰值。",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(inference_api_queue_depth{job=\"inference-api\"})",
          "legendFormat": "等待调度 / Queued",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "spanNulls": false
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 10,
      "title": "Worker 排队批次 / Queued batches",
      "description": "Waiting batches in each API-side worker proxy. Excludes the active batch and the shared API queue. A batch can contain multiple tasks. Fifteen-second scraping can miss brief peaks.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 41,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "inference_worker_queued_batches{job=\"inference-api\"}",
          "legendFormat": "{{worker_id}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "spanNulls": false
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 11,
      "title": "Worker 推理 RPC / Active inference RPCs",
      "description": "Inference calls in flight from each API-side proxy. Each proxy dispatches serially, so its value is zero or one. This is not remote CPU/GPU utilization or a count of all server RPCs.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 41,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "inference_worker_active_rpcs{job=\"inference-api\"}",
          "legendFormat": "{{worker_id}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "spanNulls": false
          },
          "decimals": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 12,
      "title": "Worker 路由状态 / Routing lifecycle",
      "description": "One indicates the current lifecycle state observed by this API. READY accepts new batches within capacity; DRAINING rejects new admission without cancelling accepted work. Removed workers stop exporting their series; historical samples remain in Prometheus.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 50,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "inference_worker_routing_state{job=\"inference-api\"}",
          "legendFormat": "{{worker_id}} {{state}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "spanNulls": false
          },
          "decimals": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    }
  ]
}
